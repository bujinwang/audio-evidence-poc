# Copy to .env and adjust. Everything has a working default for local demos.

# --- core -------------------------------------------------------------------
APP_ENV=dev
DATA_DIR=./data
# PostgreSQL (docker-compose uses this); omit to fall back to SQLite in DATA_DIR.
# DATABASE_URL=postgresql+psycopg://evidence:evidence@localhost:5432/evidence
MAX_UPLOAD_MB=512

# --- processing -------------------------------------------------------------
# 1 = process uploads inside the API request (single-process demo)
# 0 = enqueue and let `python -m app.worker` drain the queue (docker-compose)
PROCESS_INLINE=1
WORKER_POLL_SECONDS=1.0

# --- transcription ----------------------------------------------------------
# auto | whisperx | faster-whisper | sidecar | none
# `auto` prefers a real ASR engine over the sidecar reference transcript.
TRANSCRIBER=auto
# tiny | base | small | medium | large-v3. Downloaded on first use to ~/.cache.
# Measured on the noisy test set: small 3.9% WER, base 4.7% WER (CPU, int8).
WHISPER_MODEL=small
WHISPER_DEVICE=auto          # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8    # int8 on CPU, float16 on GPU
DIARIZATION=false
HF_TOKEN=                    # required only for diarization

# --- denoising --------------------------------------------------------------
# auto | deepfilternet | none
DENOISER=auto

# --- retrieval --------------------------------------------------------------
# auto | sentence-transformers | hashing
EMBEDDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto | qdrant | local
VECTOR_STORE=auto
QDRANT_URL=                  # e.g. http://localhost:6333 — empty means local index
QDRANT_COLLECTION=evidence_segments
QDRANT_API_KEY=
SEARCH_DEFAULT_LIMIT=20
SEMANTIC_MIN_SCORE=0.05

# --- access control (PoC only — replace with SSO) ---------------------------
ALLOW_ANONYMOUS=true
DEV_DEFAULT_ACTOR=demo.investigator
DEV_DEFAULT_ROLE=admin

# --- http -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
