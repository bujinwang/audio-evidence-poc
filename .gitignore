# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# node
node_modules/
dist/
.vite/

# environment
.env
.env.local

# data: never commit evidence, derivatives, or the demo database
# The bare `app.db` pattern is not enough on its own: running a script from
# `backend/` creates `backend/app.db`, which sat untracked (and empty) for a
# while because only `data/app.db` was listed.
app.db
app.db-*
data/originals/
data/working/
data/denoised/
data/exports/

# Public audio library: the provenance note is committed, the audio is not.
# Rebuild the clips with scripts/fetch_public_audio.sh
data/public-audio/*.wav
data/public-audio/*.flac
data/public-audio/*.mp3

# os
.DS_Store

# tool caches
.ruff_cache/

# Large real-audio binaries. The transcripts, scripts and README are committed
# so the measurement is reproducible; the 33 MB press-conference audio is not.
# Regenerate with yt-dlp — see data/real-audio/eps-presser/README.md
data/real-audio/eps-presser/*.flac
data/real-audio/eps-presser/*.wav
data/real-audio/eps-presser/words.json

# Internal commercial strategy, written about a live client relationship.
# Kept on disk, never published: it contains a ranked build plan and a meeting
# script for a specific company, which is not something to have indexed under
# your own name while that relationship is active.
docs/TECHNOLOGY_NORTH_GAP_ANALYSIS.md

